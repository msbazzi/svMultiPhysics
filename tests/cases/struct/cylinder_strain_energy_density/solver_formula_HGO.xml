<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 5 </Number_of_time_steps>
  <Time_step_size> 1e-2 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result_formula </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 10 </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>

</GeneralSimulationParameters>


<Add_mesh name="msh" >

  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="inlet">
      <Face_file_path> mesh/mesh-surfaces/inlet.vtp </Face_file_path>
  </Add_face>

  <Add_face name="outlet">
      <Face_file_path> mesh/mesh-surfaces/outlet.vtp </Face_file_path>
  </Add_face>

  <Add_face name="outer">
      <Face_file_path> mesh/mesh-surfaces/outer.vtp </Face_file_path>
  </Add_face>

  <Add_face name="inner">
      <Face_file_path> mesh/mesh-surfaces/inner.vtp </Face_file_path>
  </Add_face>

</Add_mesh>



<!--
  Isochoric strain energy matching the hard-coded HGO branch in mat_models.cpp:
    C10 = mu/2 with mu = 0.5*E/(1+nu)  =>  C10 = E/(4*(1+nu))
    Eff  = kap*I1 + (1-3*kap)*I4 - 1 ,   Ess = kap*I1 + (1-3*kap)*I8 - 1
  with I1,I4,I8 the modified invariants (same indexing as CANN / computeInvariantsAndDerivatives).
  Psi_iso = C10*(I1-3) + (a4/(2*b4))*(exp(b4*Eff^2)-1) + (a6/(2*b6))*(exp(b6*Ess^2)-1) .
  Volumetric part: same ST91 penalty as solver.xml (not part of this expression).
-->
<Add_equation type="struct" >

   <Coupled> true </Coupled>
   <Min_iterations> 3 </Min_iterations>
   <Max_iterations> 20 </Max_iterations>
   <Tolerance> 1e-9 </Tolerance>

   <Density> 1.0 </Density>
   <Elasticity_modulus> 1.0e5 </Elasticity_modulus>
   <Poisson_ratio> 0.483333 </Poisson_ratio>

   <Constitutive_model type="Formula">
      <Strain_energy_expression>(1.0e5/(4.0*(1.0+0.483333)))*(I1-3.0) + (3.0e4/(2.0*8.0))*(exp(8.0*((0.25*I1+0.25*I4-1.0)^2))-1.0) + (3.0e4/(2.0*8.0))*(exp(8.0*((0.25*I1+0.25*I8-1.0)^2))-1.0)</Strain_energy_expression>
      <Finite_difference_step> 1.0e-6 </Finite_difference_step>
   </Constitutive_model>

   <Dilational_penalty_model> ST91 </Dilational_penalty_model>
   <Penalty_parameter> 1.0e6 </Penalty_parameter>

    <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Velocity> true </Velocity>
     <Jacobian> true </Jacobian>
     <Stress> true </Stress>
     <Strain> true </Strain>
     <Cauchy_stress> true </Cauchy_stress>
     <Def_grad> true </Def_grad>
     <VonMises_stress> true </VonMises_stress>
   </Output>

   <LS type="GMRES" >
      <Linear_algebra type="fsils" >
         <Preconditioner> fsils </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-9 </Tolerance>
      <Max_iterations> 1000 </Max_iterations>
      <Krylov_space_dimension> 50 </Krylov_space_dimension>
   </LS>


   <Add_BC name="inlet" >
      <Type> Dirichlet </Type>
      <Value> 0.0 </Value>
   </Add_BC>
   
      <Add_BC name="outlet" >
      <Type> Dirichlet </Type>
      <Value> 0.0 </Value>
   </Add_BC>

   <Add_BC name="inner" >
      <Type> Neu </Type>
      <Time_dependence> Unsteady </Time_dependence>
      <Temporal_values_file_path> endo_pressure.dat </Temporal_values_file_path>
      <Ramp_function> true </Ramp_function>
      <Follower_pressure_load> true </Follower_pressure_load>
   </Add_BC>
   

</Add_equation>

</svMultiPhysicsFile>
