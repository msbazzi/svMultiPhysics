<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 8 </Number_of_time_steps>
  <Time_step_size> 1e-3 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Save_deformed_geometry_to_VTK> 1 </Save_deformed_geometry_to_VTK>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 100 </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>
</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> mesh/growth_properties.vtu </Mesh_file_path>

  <Add_face name="start">
    <Face_file_path> mesh/mesh-surfaces/start.vtp </Face_file_path>
  </Add_face>

  <Add_face name="end">
    <Face_file_path> mesh/mesh-surfaces/end.vtp </Face_file_path>
  </Add_face>

  <Add_face name="outside">
    <Face_file_path> mesh/mesh-surfaces/outside.vtp </Face_file_path>
  </Add_face>

  <Add_face name="interface">
    <Face_file_path> mesh/mesh-surfaces/interface.vtp </Face_file_path>
  </Add_face>

  <Mesh_scale_factor> 1.0 </Mesh_scale_factor>
</Add_mesh>

<Add_equation type="struct" >
  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <Max_iterations> 8 </Max_iterations>
  <Tolerance> 1e-9 </Tolerance>

  <Density> 1.0 </Density>
  <Elasticity_modulus> 1.0e5 </Elasticity_modulus>
  <Poisson_ratio> 0.45 </Poisson_ratio>

  <Constitutive_model type="neoHookean"> </Constitutive_model>
  <Dilational_penalty_model> ST91 </Dilational_penalty_model>
  <Penalty_parameter> 5.0e4 </Penalty_parameter>

  <External_cell_data>
    <File_path> mesh/growth_properties.vtu </File_path>
    <Growth_Fg_array_name> Growth_Fg </Growth_Fg_array_name>
    <Growth_ramp_steps> 8 </Growth_ramp_steps>
    <C10_array_name> Material_C10 </C10_array_name>
    <Kpen_array_name> Material_Kpen </Kpen_array_name>
  </External_cell_data>

  <Output type="Spatial" >
    <Displacement> true </Displacement>
    <Velocity> true </Velocity>
    <Jacobian> true </Jacobian>
    <Stress> true </Stress>
    <Strain> true </Strain>
    <Cauchy_stress> true </Cauchy_stress>
    <Def_grad> true </Def_grad>
    <Growth_Fg> true </Growth_Fg>
    <VonMises_stress> true </VonMises_stress>
  </Output>

  <LS type="GMRES" >
    <Linear_algebra type="fsils" >
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
    <Tolerance> 1e-10 </Tolerance>
    <Max_iterations> 500 </Max_iterations>
    <Krylov_space_dimension> 50 </Krylov_space_dimension>
  </LS>

  <Add_BC name="start" >
    <Type> Dirichlet </Type>
    <Value> 0.0 </Value>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
